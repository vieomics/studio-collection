TZ=Etc/UTC
JUPYTER_PORT=8888

# Jupyter authentication is disabled by design. Access control must be
# provided by the Omicslab platform, reverse proxy, or network policy.
# Do not expose port 8888 to an untrusted network.

# Optional build-time pins
# JUPYTER_VERSION=2026-10-26
# PIXI_VERSION=0.83.0
# PYTHON_VERSION=3.13
# R_VERSION=4.5.3

# The container uses the default jovyan user (UID/GID 1000:100).
# If ./data is not writable, run:
# sudo chown -R 1000:100 jupyterlab/data
