TZ=Etc/UTC
CODE_SERVER_PORT=8080

# code-server authentication is disabled by design. Access control must be
# provided by the Omicslab platform, reverse proxy, or network policy.
# Do not expose port 8080 to an untrusted network.

# The container runs as root. Files written to ./data are root-owned.
# Use `sudo chown -R "$(id -u):$(id -g)" code-server/data` if you need to
# manage them as your host user.

# Optional build-time pins
# STUDIO_VERSION=4.143.1
# PIXI_VERSION=0.83.0
# OPENCODE_VERSION=2.2.0
# NFCORE_EXTENSIONPACK_VERSION=0.8.0
