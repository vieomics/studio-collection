TZ=Etc/UTC
RSTUDIO_PORT=8787

# RStudio authentication is disabled by design. Access control must be
# provided by the Omicslab platform, reverse proxy, or network policy.
# Do not expose port 8787 to an untrusted network.

# Optional build-time pins
# RSTUDIO_VERSION=4.6.1
# PIXI_VERSION=0.83.0
# R_PIXI_VERSION=4.6.1

# The container uses the default rstudio user (UID/GID 1000).
# If ./data is not writable, run:
# sudo chown -R 1000:1000 rstudio/data
